  },

  "calculationFramework": {
    "futureCostFormula": "CURRENT_COST * (1 + INFLATION_RATE) ^ YEARS_TO_GOAL",
    "futureValueOfCurrentAssetsFormula": "CURRENT_ASSIGNED_ASSETS * (1 + EXPECTED_RETURN) ^ YEARS_TO_GOAL",
    "futureValueOfContributionsFormula": "CALCULATED_USING_PERIODIC_CONTRIBUTIONS_AND_EXPECTED_RETURN",
    "fundingRatioFormula": "(PROJECTED_CURRENT_ASSETS_FV + PROJECTED_CONTRIBUTIONS_FV) / REQUIRED_GOAL_CORPUS",
    "shortfallFormula": "MAX(0, REQUIRED_GOAL_CORPUS - PROJECTED_AVAILABLE_CORPUS)",
    "surplusFormula": "MAX(0, PROJECTED_AVAILABLE_CORPUS - REQUIRED_GOAL_CORPUS)"
  },

