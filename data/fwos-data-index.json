  "registryRules": [
    "EVERY_CORE_DATA_FILE_SHOULD_BE_REGISTERED_HERE",
    "FILE_PATHS_MUST_BE_UNIQUE",
    "DEPENDENCIES_SHOULD_REFERENCE_REGISTERED_FILES",
    "STATUS_SHOULD_BE_UPDATED_WHEN_A_FILE_IS_CREATED_OR MATERIALLY_REVISED",
    "DEPRECATED_FILES_SHOULD_NOT_BE_DELETED_WITHOUT MIGRATION_DOCUMENTATION",
    "SENSITIVE_AUTHENTICATION_INFORMATION_MUST_NOT_BE STORED_IN FWOS"
  ],

  "statusDefinitions": {
    "ACTIVE": "Current and approved for operational use.",
    "PROVISIONAL": "Usable framework but contains unresolved data gaps or assumptions.",
    "DRAFT": "Under development and not yet approved.",
    "PENDING": "Planned but not yet created.",
    "DEPRECATED": "Retained for historical or migration purposes but not for current use."
  },

  "updateFrequencies": {
    "EVENT_DRIVEN": "Update whenever a material relevant event occurs.",
    "QUARTERLY": "Review approximately every three to four months.",
    "ANNUALLY": "Review once per year.",
    "MONTHLY_OR_TRANSACTIONAL": "Update from regular transactions or portfolio records.",
    "RARE": "Update only when strategic policy changes."
  },

