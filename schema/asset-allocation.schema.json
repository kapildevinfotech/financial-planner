{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fwos.local/schemas/asset-allocation.schema.json",
  "title": "FWOS Asset Allocation Schema",
  "description": "Validation schema for strategic and tactical asset allocation data.",
  "type": "object",

  "required": [
    "schemaVersion",
    "dataVersion",
    "asOfDate",
    "currency",
    "strategicAssetAllocation"
  ],

  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },

    "dataVersion": {
      "type": "string",
      "minLength": 1
    },

    "asOfDate": {
      "type": "string",
      "format": "date"
    },

    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },

    "status": {
      "type": "string",
      "minLength": 1
    },

    "strategicAssetAllocation": {
      "type": "object",

      "required": [
        "scope",
        "allocations"
      ],

      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "INVESTABLE_FINANCIAL_PORTFOLIO",
            "TOTAL_FINANCIAL_ASSETS",
            "HOUSEHOLD_CORE",
            "CUSTOM"
          ]
        },

        "targetEquityRangePercent": {
          "$ref": "fwos.schema.json#/$defs/percentageRange"
        },

        "allocations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,

          "items": {
            "$ref": "#/$defs/strategicAllocation"
          }
        }
      },

      "additionalProperties": true
    },

    "tacticalAssetAllocation": {
      "type": "object",

      "properties": {
        "enabled": {
          "type": "boolean"
        },

        "maximumDeviationFromStrategicTargetPercent": {
          "$ref": "fwos.schema.json#/$defs/percentage"
        },

        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tacticalRule"
          }
        }
      },

      "additionalProperties": true
    },

    "currentAllocation": {
      "type": "array",

      "items": {
        "$ref": "#/$defs/currentAllocation"
      }
    },

    "rebalancing": {
      "$ref": "#/$defs/rebalancingConfiguration"
    },

    "validationRules": {
      "$ref": "#/$defs/validationConfiguration"
    },

    "references": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },

  "$defs": {
    "strategicAllocation": {
      "type": "object",

      "required": [
        "assetClass",
        "minimumPercent",
        "targetPercent",
        "maximumPercent"
      ],

      "properties": {
        "assetClass": {
          "$ref": "fwos.schema.json#/$defs/assetClass"
        },

        "minimumPercent": {
          "$ref": "fwos.schema.json#/$defs/percentage"
        },

        "targetPercent": {
          "$ref": "fwos.schema.json#/$defs/percentage"
        },

        "maximumPercent": {
          "$ref": "fwos.schema.json#/$defs/percentage"
        },

        "role": {
          "type": "string"
        },

        "includedSubAssetClasses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },

        "excludedAssets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },

      "allOf": [
        {
          "if": {
            "properties": {
              "minimumPercent": {
                "type": "number"
              },
              "targetPercent": {
                "type": "number"
              }
            },
            "required": [
              "minimumPercent",
              "targetPercent"
            ]
          },
          "then": {
            "description": "Application validation must confirm minimumPercent <= targetPercent."
          }
        },
        {
          "if": {
            "properties": {
              "targetPercent": {
                "type": "number"
              },
              "maximumPercent": {
                "type": "number"
              }
            },
            "required": [
              "targetPercent",
              "maximumPercent"
            ]
          },
          "then": {
            "description": "Application validation must confirm targetPercent <= maximumPercent."
          }
        }
      ],

      "additionalProperties": true
    },

    "currentAllocation": {
      "type": "object",

      "required": [
        "assetClass"
      ],

      "properties": {
        "assetClass": {
          "$ref": "fwos.schema.json#/$defs/assetClass"
        },

        "currentValue": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },

        "currentPercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },

        "targetPercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },

        "deviationPercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -100,
          "maximum": 100
        },

        "status": {
          "type": "string",
          "enum": [
            "BELOW_MINIMUM",
            "BELOW_TARGET",
            "AT_TARGET",
            "ABOVE_TARGET",
            "ABOVE_MAXIMUM",
            "UNMEASURED"
          ]
        }
      },

      "additionalProperties": true
    },

    "tacticalRule": {
      "type": "object",

      "required": [
        "ruleId",
        "trigger",
        "action"
      ],

      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },

        "trigger": {
          "type": "string",
          "minLength": 1
        },

        "action": {
          "type": "string",
          "minLength": 1
        },

        "maximumAllocationImpactPercent": {
          "$ref": "fwos.schema.json#/$defs/percentage"
        },

        "requiresHumanReview": {
          "type": "boolean"
        }
      },

      "additionalProperties": true
    },

    "rebalancingConfiguration": {
      "type": "object",

      "properties": {
        "calendarReviewFrequency": {
          "type": "string",
          "enum": [
            "MONTHLY",
            "QUARTERLY",
            "SEMI_ANNUALLY",
            "ANNUALLY"
          ]
        },

        "thresholdBased": {
          "type": "boolean"
        },

        "absoluteDeviationThresholdPercent": {
          "$ref": "fwos.schema.json#/$defs/percentage"
        },

        "preferredRebalancingSequence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "taxAware": {
          "type": "boolean"
        }
      },

      "additionalProperties": true
    },

    "validationConfiguration": {
      "type": "object",

      "properties": {
        "targetAllocationMustTotalPercent": {
          "type": "number",
          "const": 100
        },

        "currentAllocationMustTotalPercent": {
          "type": "number",
          "const": 100
        },

        "enforceMinimumLessThanOrEqualTarget": {
          "type": "boolean"
        },

        "enforceTargetLessThanOrEqualMaximum": {
          "type": "boolean"
        },

        "enforceUniqueAssetClasses": {
          "type": "boolean"
        }
      },

      "additionalProperties": false
    }
  },

  "additionalProperties": true
}
