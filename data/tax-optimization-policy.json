      "DO_NOT_MOVE_LARGE_AMOUNTS_BETWEEN_FAMILY_MEMBERS_WITHOUT REVIEWING_TAX_AND_DOCUMENTATION",
      "MAINTAIN_SEPARATE_PORTFOLIO_RECORDS_EVEN_IF KAPIL_MANAGES_BOTH"
    ]
