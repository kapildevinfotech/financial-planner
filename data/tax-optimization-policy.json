    ]
  },

  "corePrinciples": [
    "LEGAL_OWNERSHIP_DETERMINES_TAXPAYER",
    "FAMILY_LEVEL_PLANNING_DOES_NOT_ERASE_ACCOUNT_OWNERSHIP",
    "VERIFY_CURRENT_TAX_LAW_BEFORE_MATERIAL_TRANSACTIONS",
    "MINIMIZE_UNNECESSARY_TAXABLE_CHURN",
    "USE_NEW_CASH_FLOWS_FOR_REBALANCING_WHERE_PRACTICAL",
    "CONSIDER_POST_TAX_RETURN_NOT ONLY PRE_TAX_RETURN",
    "DO_NOT_DELAY A NECESSARY RISK_REDUCTION_SOLELY_TO AVOID TAX",
    "DOCUMENT_MATERIAL_TAX_ASSUMPTIONS"
