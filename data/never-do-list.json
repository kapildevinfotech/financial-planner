{
  "schemaVersion": "1.0.0",
  "dataVersion": "2026.07",
  "asOfDate": "2026-07-12",
  "status": "ACTIVE_GUARDRAILS",

  "purpose": {
    "primaryObjective": "Prevent avoidable financial mistakes caused by fear, greed, complexity, leverage, poor verification, conflicts between goals and investments, or uncontrolled business risk.",
    "principle": "Long-term wealth is protected as much by avoiding major mistakes as by selecting good investments."
  },

  "priorityLevels": {
    "HARD_STOP": "Do not proceed unless the FWOS policy itself is formally amended after documented analysis.",
    "STRONG_DEFAULT": "Avoid unless there is a specific, documented and evidence-based justification.",
    "CAUTION": "Proceed only after completing the relevant decision checklist."
  },

  "marketBehaviour": [
    {
      "rule": "NEVER_PANIC_SELL_BECAUSE_OF_HEADLINES",
      "priority": "HARD_STOP",
      "examples": [
        "MARKET_CRASH_PREDICTIONS",
        "WAR_HEADLINES",
        "RECESSION_PREDICTIONS",
        "POPULAR_INVESTOR_WARNINGS",
        "SOCIAL_MEDIA_PANIC"
      ],
      "exception": "A documented structural change that invalidates the investment thesis or strategic asset allocation."
    },
    {
      "rule": "NEVER_EXIT_EQUITY_ONLY_BECAUSE_THE_MARKET_HAS_FALLEN",
      "priority": "HARD_STOP",
      "requiredAction": "FOLLOW_CRASH_PLAYBOOK_AND_REBALANCING_POLICY"
    },
    {
      "rule": "NEVER_BUY_ONLY_BECAUSE_PRICES_HAVE_FALLEN",
      "priority": "STRONG_DEFAULT",
      "requiredChecks": [
        "ASSET_IS_APPROVED",
        "VALUATION_AND FUNDAMENTALS_ARE_ACCEPTABLE",
        "ASSET_ALLOCATION_SUPPORTS_PURCHASE",
        "LIQUIDITY_IS_NOT_COMPROMISED"
      ]
    },
    {
      "rule": "NEVER_TRY_TO_PREDICT_EXACT_MARKET_TOPS_OR_BOTTOMS",
      "priority": "STRONG_DEFAULT"
    },
    {
      "rule": "NEVER_STOP_LONG_TERM_SIPS_ONLY_BECAUSE_MARKETS_ARE_VOLATILE",
      "priority": "STRONG_DEFAULT",
      "exceptions": [
        "CASH_FLOW_STRESS",
        "GOAL_REACHED",
        "ASSET_ALLOCATION_REQUIRES_REDIRECTION",
        "INVESTMENT_PRODUCT_NO_LONGER_PASSES REVIEW"
      ]
    }
  ],

